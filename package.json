{
  "name": "website-parser",
  "version": "1.0.0",
  "private": true,
  "description": "Scrapes online shops and exports product catalogs to Excel. Runs on GitHub Actions, UI on GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "scrape": "node src/cli.js",
    "compare": "node test/compare.js",
    "test": "node --test test/*.test.js",
    "site": "node scripts/build-site.js --files output --out _site && npx --yes http-server _site -p 8080 -c-1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0"
  }
}
